---
import Layout from "../layouts/Layout.astro";
import CTABand from "../components/CTABand.astro";
import { withBase } from "../lib/base";

const IQ = "/images/photos/clinics/ibogaquest/";

// Clinics we are willing to point people toward. Written from each clinic's
// own copy and published protocols; photos are theirs, used with permission.
// New clinics are added here and render as another entry below.
const clinics = [
  {
    name: "IbogaQuest",
    meta: "Tepoztlán, Morelos, Mexico · Since 2009",
    href: "https://ibogaquest.com/",
    site: "ibogaquest.com",
    body: [
      "IbogaQuest offers medically supervised ibogaine treatment in Tepoztlán, Morelos, about 90 minutes south of Mexico City. The team has done this work since 2009 and stays small on purpose: one group a month, up to seven participants, Monday to Monday.",
      "Care begins long before anyone travels. Each person goes through a medical and psychological intake, and the medical team reviews an EKG and lab work before arrival. During the week there is on-site medical supervision, two medicine sessions, and therapeutic and integration support every day, along with massage, temazcal, a mountain hike and Janzu water therapy. The work holds iboga's roots in the Bwiti traditions of Gabon, Cameroon and the Republic of the Congo with respect.",
      "The week in Mexico is a beginning. When a guest fits what Casa da Nova Vida offers, or would like to keep integrating back in the U.S., IbogaQuest refers them to the house.",
    ],
    gallery: [
      { src: IQ + "house-garden.jpg", alt: "The IbogaQuest treatment house, garden and pool with the mountains of Tepoztlán behind" },
      { src: IQ + "terrace.jpg", alt: "A covered terrace with seating, looking out over the garden and pool" },
      { src: IQ + "common-room.jpg", alt: "The common room, with a beamed wooden ceiling and a stone fireplace" },
      { src: IQ + "garden-mountains.jpg", alt: "The garden in bloom beneath the cliffs of Tepoztlán" },
    ],
  },
];

const listSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Ibogaine clinics trusted by Casa da Nova Vida",
  itemListElement: clinics.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: { "@type": "Organization", name: c.name, url: c.href },
  })),
};
---

<Layout
  title="Trusted Clinics · Casa da Nova Vida"
  description="The ibogaine clinics we trust enough to name. Casa da Nova Vida is an aftercare and integration sanctuary in the Texas Hill Country, for the part that comes after treatment."
  schema={listSchema}
>
  <!-- ===================== HERO ===================== -->
  <section class="relative isolate overflow-hidden px-6 pb-14 sm:pb-20 pt-24 text-linen lg:px-10 lg:pb-16 lg:pt-40">
    <img
      src={withBase("/images/photos/mountain-sunrise.jpg")}
      alt="First light over a mountain ridge"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-bottom sm:object-center"
      loading="eager"
    />
    <!-- The sun flare sits dead centre, which is exactly where the headline
         lands on a phone, so this scrim runs heavier than the Resources one. -->
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-bark/85 via-pine/85 to-pine/90"></div>
    <div class="mx-auto max-w-3xl text-center [text-shadow:0_2px_20px_rgba(20,26,36,0.55)]">
      <p class="eyebrow rise text-gold">Trusted Clinics</p>
      <h1 class="rise rise-2 mt-5 text-4xl leading-[1.1] sm:text-5xl">Trusted Clinics</h1>
      <p class="rise rise-3 mx-auto mt-5 font-display text-xl italic text-sagelight sm:text-2xl">
        Where the work begins.
      </p>
      <p class="rise rise-3 mx-auto mt-6 max-w-2xl leading-relaxed text-cream/90">
        We are not a clinic and we do not administer ibogaine. Because it cannot
        be legally administered in the United States, almost everyone who
        reaches us is choosing a treatment center abroad first. These are the
        ones we trust.
      </p>
    </div>
  </section>

  <!-- ===================== THE CLINICS ===================== -->
  <section class="px-6 py-12 sm:py-16 lg:px-10 lg:py-16">
    <div class="mx-auto max-w-6xl">
      <p class="eyebrow">Trusted clinics</p>
      <h2 class="mt-3 text-2xl text-pine sm:text-4xl">Places we would send our own</h2>
      <p class="mt-5 max-w-2xl leading-relaxed text-cocoa">
        A short list on purpose. We look for real medical screening before you
        travel, qualified people on site overnight, small groups, and honesty
        about what one week can and cannot do.
      </p>

      <div class="mt-10 space-y-8">
        {
          clinics.map((c) => (
            <article class="overflow-hidden rounded-2xl border border-sand bg-parchment shadow-sm">
              <div class="grid lg:grid-cols-2">
                <div class="flex h-full flex-col gap-2 p-2">
                  <img
                    src={withBase(c.gallery[0].src)}
                    alt={c.gallery[0].alt}
                    class="h-56 w-full flex-1 rounded-xl object-cover sm:h-72"
                    loading="lazy"
                  />
                  <div class="grid shrink-0 grid-cols-3 gap-2">
                    {c.gallery.slice(1).map((g) => (
                      <img
                        src={withBase(g.src)}
                        alt={g.alt}
                        class="h-24 w-full rounded-xl object-cover sm:h-28"
                        loading="lazy"
                      />
                    ))}
                  </div>
                </div>

                <div class="flex flex-col p-6 sm:p-8">
                  <p class="text-[0.7rem] uppercase tracking-[0.16em] text-clay">{c.meta}</p>
                  <h3 class="mt-2 font-display text-2xl text-pine">{c.name}</h3>
                  {c.body.map((p) => (
                    <p class="mt-3 text-sm leading-relaxed text-cocoa">{p}</p>
                  ))}
                  <a
                    href={c.href}
                    target="_blank"
                    rel="noopener"
                    class="mt-6 inline-flex items-center gap-1.5 self-start border-t border-sand pb-2 pt-4 text-sm font-medium text-forest transition-colors hover:text-pine"
                  >
                    Visit {c.site}
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <p class="mt-8 max-w-3xl text-xs leading-relaxed text-clay">
        Casa da Nova Vida does not own or operate the clinics named here, and no
        clinic pays to appear on this page. We refer people to them and some of
        them refer people to us; no money changes hands in either direction.
        Photographs are each clinic's own. Nothing here is medical advice:
        ibogaine carries real cardiac risk, and any decision about it belongs
        with the clinic's medical team and a physician who knows your history.
      </p>
    </div>
  </section>

  <div class="pb-14 sm:pb-20 lg:pb-20">
    <CTABand
      heading="Going to a clinic? Let's talk about after."
      body="Tell us where you are headed and when you fly home, and we will help you plan the part that comes next."
    />
  </div>
</Layout>
